#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Run checks, ask a read-only harness for a commit message, and commit.

set -euo pipefail

LOGDIR=".tmp-commit-skill"
# Written by hooks/record-attribution.py, one `<Tool>|<Model>` line per model
# that changed a file here. Repo-root-relative, so a worktree reads its own.
# Not under $LOGDIR: that is wiped at the start of every invocation, by this
# script and by detect-checks.sh independently, and the record has to survive
# both to accumulate across sessions.
RECORDDIR=".commit-attribution"
RECORD="$RECORDDIR/record"
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
MESSAGE_PROMPT="$SCRIPT_DIR/../references/commit-message-prompt.md"
CHECKS="$SCRIPT_DIR/util/detect-checks.sh"
HARNESS="${COMMIT_HARNESS:-claude}"
MODEL="${COMMIT_MODEL:-sonnet}"
EFFORT="${COMMIT_EFFORT:-medium}"
# The closed set from references/commit-message-prompt.md, which tracks
# Angular's list. Used twice below: to validate, and to name the allowed types
# when a message is rejected for using something else.
TYPES="feat|fix|build|ci|docs|perf|refactor|test"

# Optional: the author's guidance for the message. A harness reading a raw diff
# infers intent, framing and emphasis from the code alone and is frequently
# wrong about all three; this is how the author steers it.
# Quoting matters — `commit this is a refactor` would pass "this" and silently
# drop the rest, so anything past one argument is a usage error, not a guess.
[ "$#" -le 1 ] || {
  echo "Usage: commit [\"guidance for the commit message\"]" >&2
  echo "Got $# arguments. Quote the guidance as a single string." >&2
  exit 1
}
GUIDANCE="${1:-}"

prefix=$(git rev-parse --show-prefix 2>/dev/null) || {
  echo "Not a git repository (cwd: $PWD)" >&2
  exit 1
}
[ -z "$prefix" ] || {
  echo "Must be invoked from repo root. Currently ${prefix%/} below it." >&2
  exit 1
}

git diff --staged --quiet && {
  echo "Nothing is staged"
  exit 0
}

rm -rf "$LOGDIR"
mkdir -p "$LOGDIR"
printf '*\n' > "$LOGDIR/.gitignore"

message_prompt() {
  cat "$MESSAGE_PROMPT"
  # Omitted entirely when empty, so the harness never sees an empty block and
  # reads it as the author having nothing to say.
  [ -z "$GUIDANCE" ] || printf '\n--- BEGIN AUTHOR GUIDANCE ---\n%s\n--- END AUTHOR GUIDANCE ---\n' "$GUIDANCE"
  printf '\n--- BEGIN STAGED DIFF ---\n'
  git diff --staged
  printf '\n--- END STAGED DIFF ---\n'
}

# The prompt reaches the harness on stdin, never as an argv string. Linux caps
# a SINGLE argument at MAX_ARG_STRLEN (32 pages = 128 KiB) independently of
# ARG_MAX, so a staged diff a few hundred KB long fails with "Argument list too
# long" before the harness starts, on a machine whose ARG_MAX is 2 MiB. Both
# harnesses read a prompt from stdin: `claude -p` with no positional prompt,
# and `codex exec -`.
generate_message() {
  local prompt="$LOGDIR/message-prompt.txt"
  local output="$LOGDIR/message.raw"
  message_prompt > "$prompt"
  echo "Generating commit message with $HARNESS/$MODEL..."

  case "$HARNESS" in
    claude)
      command -v claude >/dev/null 2>&1 || {
        echo "Claude is not installed or not on PATH." >&2
        return 1
      }
      if ! claude --tools "" --permission-mode plan \
        -p --model "$MODEL" --effort "$EFFORT" \
        < "$prompt" > "$output" 2> "$LOGDIR/harness.log"; then
        echo "Claude harness failed. See $LOGDIR/harness.log" >&2
        return 1
      fi
      ;;
    codex)
      command -v codex >/dev/null 2>&1 || {
        echo "Codex is not installed or not on PATH." >&2
        return 1
      }
      if ! codex exec --sandbox read-only \
        --model "$MODEL" -c "model_reasoning_effort=$EFFORT" - \
        < "$prompt" > "$output" 2> "$LOGDIR/harness.log"; then
        echo "Codex harness failed. See $LOGDIR/harness.log" >&2
        return 1
      fi
      ;;
    *)
      echo "Unsupported COMMIT_HARNESS: $HARNESS (use claude or codex)." >&2
      return 1
      ;;
  esac

  sed -e '1{/^[[:space:]]*$/d;}' -e '${/^[[:space:]]*$/d;}' "$output" > "$LOGDIR/message.txt"
  local title
  title=$(head -n1 "$LOGDIR/message.txt")
  if [ -z "$title" ] || grep -q '^Assisted-by:' "$LOGDIR/message.txt" ||
     [[ "$title" == *'```'* ]] ||
     ! [[ "$title" =~ ^($TYPES)(\([^()]+\))?(!)?:[[:space:]][^[:space:]].*$ ]] ||
     [ "${#title}" -gt 72 ]; then
    # Name the bad type when that is the problem. Guidance asking for a type
    # off the list is the likeliest cause — a harness follows the author over
    # the rules — and the generic message below sends the reader to a log to
    # work out something the script already knows.
    # Captured before the next [[ =~ ]], which overwrites BASH_REMATCH.
    local used=""
    if [[ "$title" =~ ^([a-zA-Z]+)(\([^()]+\))?!?: ]]; then
      used="${BASH_REMATCH[1]}"
    fi
    if [ -n "$used" ] && ! [[ "$used" =~ ^($TYPES)$ ]]; then
      echo "Commit type '$used' is not allowed. Use one of: ${TYPES//|/ }" >&2
    fi
    echo "Harness returned an invalid commit message. See $output" >&2
    return 1
  fi
}

echo "Running validation..."
if ! "$CHECKS"; then
  echo "No commit was created." >&2
  exit 1
fi
generate_message || {
  echo "No commit was created." >&2
  exit 1
}

case "$HARNESS" in
  claude) label="Claude Code" ;;
  codex) label="Codex" ;;
esac

# The recorded models are the ones that changed these files. $HARNESS/$MODEL is
# only whoever wrote the message just now, so it is the fallback and nothing
# more: no hook, no harness support, or a path nothing detected all degrade to
# exactly today's output rather than to something worse. Dedup is here rather
# than in the hook because parallel tool calls append concurrently.
trailers=""
if [ -s "$RECORD" ]; then
  trailers=$(awk -F'|' 'NF == 2 && $1 != "" && $2 != "" && !seen[$0]++ {
    printf "Assisted-by: %s (%s)\n", $1, $2
  }' "$RECORD")
fi
[ -n "$trailers" ] || trailers="Assisted-by: $label ($MODEL)"
printf '\n%s\n' "$trailers" >> "$LOGDIR/message.txt"

git commit --file "$LOGDIR/message.txt"
# A successful commit consumes the record; `set -e` means a failed one never
# reaches here and keeps it for the retry.
rm -f "$RECORD"
# The attribution hook fires once more for the shell call that ran this script,
# and would record whoever committed as an author of whatever is still
# uncommitted. That is the misattribution this whole mechanism exists to
# remove, and it is the normal case: code written in one harness, committed in
# another. The hook deletes this marker and skips exactly that one record.
# Only when the directory already exists — no hook installed means nothing to
# suppress, and creating it here would leave an untracked directory behind.
if [ -d "$RECORDDIR" ]; then
  : > "$RECORDDIR/skip-next"
fi
echo "Logs: $LOGDIR/"

echo ""

git log -1
